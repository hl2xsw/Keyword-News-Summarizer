rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Searches collection - currently public/shared or per-user?
    // User request implies chronological history for them.
    // We'll tie it to auth if available, but for this applet, let's assume one user or shared demo.
    // If we want private history, we need userId.
    match /searches/{searchId} {
      allow read: if true; // Public for this demo, or restrict to isSignedIn()
      allow create: if isSignedIn() 
                    && incoming().keyword is string 
                    && incoming().keyword.size() <= 100
                    && incoming().timestamp == request.time;
    }

    match /summaries/{summaryId} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && incoming().userId == request.auth.uid
                    && incoming().summary is string
                    && incoming().timestamp == request.time;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
